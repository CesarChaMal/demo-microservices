# Security Configuration
# Change these values in production!

# JWT Secret Keys
JWT_SECRET=your-super-secure-jwt-secret-key-change-in-production

# Database Credentials
MYSQL_ROOT_PASSWORD=secure-root-password
MYSQL_DATABASE=appdb
MYSQL_USER=appuser
MYSQL_PASSWORD=secure-app-password

# Service URLs
EUREKA_SERVER_URL=http://eureka-server:8761/eureka/
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/appdb
# Redis host is the compose service name; use redis://localhost:6379 when running services outside Docker
REDIS_URL=redis://redis:6379

# RabbitMQ (message broker for the messaging patterns; management UI on :15672).
# RABBITMQ_URL must embed the SAME credentials as RABBITMQ_USER/PASS.
RABBITMQ_USER=change-me-broker-user
RABBITMQ_PASS=change-me-broker-password
RABBITMQ_URL=amqp://change-me-broker-user:change-me-broker-password@rabbitmq:5672/%2F

# Environment
NODE_ENV=development
FLASK_ENV=development
SPRING_PROFILES_ACTIVE=development