<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>demo_dotnet_service</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Steeltoe 4.x: the Eureka client package pulls in everything needed
         (replaces the 3.x ClientCore + Eureka two-package combo). -->
    <PackageReference Include="Steeltoe.Discovery.Eureka" Version="4.3.0" />
  </ItemGroup>

</Project>
